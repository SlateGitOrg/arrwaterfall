		sourceColumn: customer_id

	column segment
		dataType: string
		lineageTag: b5c3720b-6a6a-5822-af98-f8aa12c55cd2
		summarizeBy: none
		sourceColumn: segment

	column currency
		dataType: string
		lineageTag: 6a67f6b5-8e50-55ec-9b11-d484b2110aa1
		summarizeBy: none
		sourceColumn: currency

	column first_contract_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: e498496b-ac1d-58ca-8ae7-c38259533d7e
		summarizeBy: none
